{
  "name": "@pi-dalamud/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && oxlint src test",
    "format": "prettier --check src test ../../test-fixtures"
  },
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
